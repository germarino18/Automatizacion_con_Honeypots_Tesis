    {
      "parameters": {
        "jsCode": "const event = $input.all()[0].json || {};\nconst command = event.input || event.command || event.commands || '';\n\nconst urlRegex = /(https?:\\/\\/[^\\s]+)/g;\nconst urls = command.match(urlRegex) || [];\n\nconst domainRegex = /(?:https?:\\/\\/)?([\\w\\-]+\\.[\\w\\-\\.]+)/g;\nconst domains = command.match(domainRegex) || [];\n\nconst dangerousCommands = ['rm -rf', 'chmod 777', 'nc -e', 'wget', 'curl', 'python -c', 'bash -i'];\nconst isDangerous = dangerousCommands.some(dc => command.toLowerCase().includes(dc));\n\nconst ip = event.src_ip || event.source_ip || '';\nconst valid = /^(\\d{1,3}\\.){3}\\d{1,3}$/.test(ip) && ip.split('.').every(n => +n >= 0 && +n <= 255);\n\nreturn [{\n  json: {\n    timestamp: event.timestamp || new Date().toISOString(),\n    source_honeypot: 'cowrie',\n    src_ip: valid ? ip : '0.0.0.0',\n    dst_port: event.dst_port || event.port || null,\n    protocol: event.protocol || 'ssh',\n    username: event.username || null,\n    session_id: event.session || event.session_id,\n    commands: command,\n    extracted_urls: urls,\n    extracted_domains: domains,\n    is_dangerous_command: isDangerous,\n    playbook_id: 'PB-H2-v1.0',\n    att_ck_technique: 'T1059',\n    event_id: event.event_id || null,\n    enrichment_data: {},\n    raw_data: event\n  }\n}];"
      },
      "id": "557b8117-0011-4ae1-9bf5-60920c408358",
