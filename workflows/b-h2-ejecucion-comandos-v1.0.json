    {
      "parameters": {
        "functionCode": "// Calcular score de riesgo para comandos\n// Referencias a nodos de enriquecimiento (VirusTotal/WHOIS) con fallback\n// base: evento limpio desde Extraer IOCs (robusto aunque el enriquecimiento falle)\nconst baseItems = $('Extraer IOCs').all() || [];\nconst base = (baseItems[0] && baseItems[0].json) ? baseItems[0].json : (($input.all()[0] && $input.all()[0].json) || {});\nconst vtItems = $('VirusTotal Lookup').all() || [];\nconst whoisItems = $('WHOIS Domain').all() || [];\n\nconst vtData = (vtItems[0] && vtItems[0].json && vtItems[0].json.data) || {};\nconst whoisData = (whoisItems[0] && whoisItems[0].json) || {};\n\nlet score = 0;\n\n// Score por detecciones en VirusTotal\nconst vtDetections = vtData.attributes?.last_analysis_stats?.malicious || 0;\nif (vtDetections > 5) score += 0.4;\nif (vtDetections > 10) score += 0.2;\n\n// Score por dominio reciente (< 30 días)\nconst domainAge = whoisData.created_date || '';\nif (domainAge) {\n  const created = new Date(domainAge);\n  const daysOld = (new Date() - created) / (1000 * 60 * 60 * 24);\n  if (daysOld < 30) score += 0.3;\n}\n\n// Score por comando peligroso\nif (base.is_dangerous_command) score += 0.3;\n\n// Score por múltiples URLs\nif ((base.extracted_urls || []).length > 2) score += 0.2;\n\nscore = Math.min(score, 1.0);\n\nreturn [{\n  json: {\n    ...base,\n    risk_score: score,\n    vt_detections: vtDetections,\n    domain_age_days: domainAge ? ((new Date() - new Date(domainAge)) / (1000 * 60 * 60 * 24)).toFixed(0) : 'N/A',\n    enrichment_timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "203cc334-28a8-4a60-908f-1f3fef63b70b",
      "name": "Calcular Risk Score1",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        128,
        640
      ],
      "onError": "continueRegularOutput"
    },
