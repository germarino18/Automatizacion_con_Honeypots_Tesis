{
  "id": "soc-glpi-ticket-01",
  "name": "SOC - GLPI Ticket Endpoint",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "glpi-ticket",
        "responseMode": "responseNode",
        "webhookId": "glpi-ticket"
      },
      "id": "webhook-ticket",
      "name": "Webhook Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "glpi-ticket"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO responses (event_id, action_type, actor, status, details)\nVALUES ($1, 'alerta', 'n8n-automated', 'completed',\n  jsonb_build_object(\n    'ticket_name', $2,\n    'content', $3,\n    'urgency', $4,\n    'created_at', now()::text\n  )\n)\nRETURNING id, timestamp",
        "options": {
          "queryReplacement": "={{ $json.body[\"event_id\"] || null }},={{ $json.body[\"name\"] }},={{ $json.body[\"content\"] }},={{ $json.body[\"urgency\"] }}"
        }
      },
      "id": "crear-ticket",
      "name": "Crear Ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {
        "postgres": {
          "id": "postgres-cred-001",
          "name": "PostgreSQL_Audit"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, message: \"Ticket created\", action_id: $json.id, timestamp: $json.timestamp }) }}"
      },
      "id": "responder",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook Ticket": {
      "main": [
        [
          {
            "node": "Crear Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Crear Ticket": {
      "main": [
        [
          {
            "node": "Responder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
