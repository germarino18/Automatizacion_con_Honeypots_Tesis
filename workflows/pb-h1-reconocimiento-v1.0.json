    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Calcular score de riesgo\n// Referencias a nodos hermanos de la rama de enriquecimiento (AbuseIPDB/Shodan/Normalizar)\nconst abuseItems = $('AbuseIPDB Lookup').all() || [];\nconst shodanItems = $('Shodan Lookup').all() || [];\nconst normalizedItems = $('Normalizar Datos').all() || [];\nconst base = (normalizedItems[0] && normalizedItems[0].json) ? normalizedItems[0].json : (($input.all()[0] && $input.all()[0].json) || {});\n\nconst abuseData = (abuseItems[0] && abuseItems[0].json && abuseItems[0].json.data) || {};\nconst shodanData = (shodanItems[0] && shodanItems[0].json) || {};\n\nlet score = 0;\n\n// Score por reputación AbuseIPDB\nconst abuseScore = abuseData.abuseConfidenceScore || 0;\nif (abuseScore > 50) score += 0.3;\nif (abuseScore > 80) score += 0.2;\n\n// Score por tipo de organización (hosting/cloud = más riesgoso)\nconst org = shodanData.org || '';\nif (org.toLowerCase().includes('hosting') || org.toLowerCase().includes('cloud')) {\n  score += 0.2;\n}\n\n// Score por múltiples puertos escaneados\nconst openPorts = shodanData.ports || [];\nif (openPorts.length > 5) score += 0.2;\n\n// Score por vulnerabilidades conocidas\nconst vulns = shodanData.vulns || [];\nif (vulns.length > 0) score += 0.2;\n\n// Normalizar score entre 0 y 1\nscore = Math.min(score, 1.0);\n\nreturn [{\n  json: {\n    ...base,\n    risk_score: score,\n    abuse_confidence: abuseScore,\n    organization: org,\n    open_ports_count: openPorts.length,\n    has_vulns: vulns.length > 0,\n    enrichment_timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "function-scoring",
      "name": "Calcular Risk Score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300],
      "onError": "continueRegularOutput"
    },
