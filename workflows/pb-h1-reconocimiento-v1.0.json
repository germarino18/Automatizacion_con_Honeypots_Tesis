    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normalizar datos del honeypot (Corrección A - PB-H1)\nconst event = $input.all()[0].json || {};\n// n8n v2 webhook envuelve el payload en .body — desempaquetar para leer los campos del evento\nconst payload = (event.body && typeof event.body === 'object') ? event.body : event;\n\n// Validación de src_ip como inet\nconst ip = payload.src_ip || payload.source_ip || '';\nconst valid = /^(\\d{1,3}\\.){3}\\d{1,3}$/.test(ip) && ip.split('.').every(n => +n >= 0 && +n <= 255);\n\nconst normalized = {\n  timestamp: payload.timestamp || new Date().toISOString(),\n  source_honeypot: 'cowrie',\n  src_ip: valid ? ip : '0.0.0.0',\n  dst_port: payload.dst_port || payload.port || null,\n  session_id: payload.session || payload.session_id,\n  commands: payload.input || payload.command || '',\n  event_type: payload.event || 'connection',\n  playbook_id: 'PB-H1-v1.0',\n  att_ck_technique: payload.dst_port === 2222 ? 'T1595' : 'T1046',\n  eventid: payload.eventid || '',\n  username: payload.username || null,\n  protocol: payload.protocol || 'ssh',\n  enrichment_data: null,\n  raw_data: payload\n};\n\nreturn [{ json: normalized }];"
    },
    "id": "function-normalize",
    "name": "Normalizar Datos",
    "type": "n8n-nodes-base.code",
    "typeVersion": 2,
    "position": [450, 300]
  },
