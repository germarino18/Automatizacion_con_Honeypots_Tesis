# ===========================================
# .gitignore - Honeypot SOC
# ===========================================

# ---------- Variables de Entorno ----------
.env
.env.local
.env.*.local

# ---------- Datos de Servicios (volúmenes) ----------
postgres/data/
n8n/data/
grafana/*
# ...pero SE versionan provisioning y dashboards (GitOps, design D5b).
# Nota: se usa `grafana/*` (no `grafana/`) para que git pueda descender y
# re-incluir las subcarpetas versionables; el runtime DB grafana.db sigue ignorado.
!grafana/provisioning/
!grafana/provisioning/**
!grafana/dashboards/
!grafana/dashboards/**

# ---------- Logs de Honeypots ----------
cowrie/logs/
cowrie/downloads/
dionaea/logs/
dionaea/binaries/

# ---------- Certificados ----------
nginx/certs/

# ---------- Node / npm ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Sistema ----------
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ---------- Python ----------
__pycache__/
.pytest_cache/
!dionaea/python/
!dionaea/python/*.py
