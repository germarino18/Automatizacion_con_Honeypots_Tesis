        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "postgres-honeypots"
        },
        "query": "SELECT DISTINCT protocol FROM honeypot_events WHERE protocol IS NOT NULL ORDER BY protocol",
        "includeAll": true,
        "allValue": null,
        "multi": true,
        "refresh": 1,
        "sort": 1,
        "definition": "SELECT DISTINCT protocol FROM honeypot_events WHERE protocol IS NOT NULL ORDER BY protocol"
      }
