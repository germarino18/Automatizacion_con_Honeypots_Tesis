      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM honeypot_events WHERE $__timeFilter(timestamp) AND source_honeypot IN (${honeypot:sqlstring}) AND protocol IN (${protocol:sqlstring})",
          "datasource": {
            "type": "postgres",
            "uid": "postgres-honeypots"
          }
        }
      ],
