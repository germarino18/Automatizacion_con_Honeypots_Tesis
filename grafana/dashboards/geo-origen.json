{
  "uid": "geo-origen",
  "title": "Origen geográfico",
  "tags": ["honeypot", "geo"],
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-30d", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Mapa por país de origen",
      "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
      "description": "Agrupa eventos por país extraído de enrichment_data (JSONB).",
      "gridPos": { "h": 14, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(enrichment_data->>'country', '') AS lookup, COUNT(*) AS value FROM honeypot_events WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY value DESC",
          "datasource": { "type": "postgres", "uid": "postgres-honeypots" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "unit": "none" },
        "overrides": []
      },
      "options": {
        "basemap": { "type": "default", "name": "Tiles base", "config": {} },
        "layers": [{
          "type": "markers",
          "name": "Origen",
          "config": { "showLegend": true, "style": { "color": "blue", "opacity": 0.6, "size": 10 } },
          "location": { "mode": "lookup", "lookup": "lookup", "gazetteer": "countries" },
          "tooltip": { "mode": "details", "type": "list" }
        }],
        "view": { "id": "europe", "lon": 20, "lat": 20, "zoom": 1 }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Top países",
      "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
      "description": "Conteo por país desde enrichment_data.",
      "gridPos": { "h": 14, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COALESCE(enrichment_data->>'country', 'Desconocido') AS pais, COUNT(*) AS eventos FROM honeypot_events WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY eventos DESC",
          "datasource": { "type": "postgres", "uid": "postgres-honeypots" }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "unit": "none" },
        "overrides": [{ "matcher": { "id": "byName", "options": "pais" }, "properties": [{ "id": "custom.width", "value": 200 }] }]
      },
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "enablePagination": true, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "displayName": "eventos", "desc": true }] }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Top src_ip",
      "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
      "description": "IPs de origen más activas.",
      "gridPos": { "h": 14, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT src_ip, COUNT(*) AS eventos FROM honeypot_events WHERE $__timeFilter(timestamp) GROUP BY src_ip ORDER BY eventos DESC LIMIT 10",
          "datasource": { "type": "postgres", "uid": "postgres-honeypots" }
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "unit": "none" },
        "overrides": [{ "matcher": { "id": "byName", "options": "src_ip" }, "properties": [{ "id": "custom.width", "value": 200 }] }]
      },
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "enablePagination": true, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "displayName": "eventos", "desc": true }] }
    }
  ]
}