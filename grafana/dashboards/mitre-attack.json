{
  "uid": "mitre-attack",
  "title": "MITRE ATT&CK",
  "tags": ["honeypot", "mitre"],
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "technique",
        "label": "Técnica ATT&CK",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
        "query": "SELECT DISTINCT att_ck_technique FROM honeypot_events WHERE att_ck_technique IS NOT NULL ORDER BY att_ck_technique",
        "includeAll": true,
        "allValue": null,
        "multi": false,
        "refresh": 1,
        "sort": 1,
        "definition": "SELECT DISTINCT att_ck_technique FROM honeypot_events WHERE att_ck_technique IS NOT NULL ORDER BY att_ck_technique"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Eventos con técnica registrada",
      "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
      "description": "Total de eventos con técnica MITRE ATT&CK. Tolera valores NULL en att_ck_technique (se excluyen del conteo, no genera error).",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT COUNT(*) AS total FROM honeypot_events WHERE $__timeFilter(timestamp) AND att_ck_technique IS NOT NULL AND ( '$technique' = '' OR att_ck_technique = '${technique:singlequote}' )",
          "datasource": { "type": "postgres", "uid": "postgres-honeypots" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Técnicas por conteo",
      "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
      "description": "Frecuencia de técnicas ATT&CK (T1595 reconocimiento, T1046 escaneo de servicios, T1190 explotación, T1059 ejecución). Los eventos sin técnica se excluyen.",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT att_ck_technique, COUNT(*) AS eventos FROM honeypot_events WHERE $__timeFilter(timestamp) AND att_ck_technique IS NOT NULL AND ( '$technique' = '' OR att_ck_technique = '${technique:singlequote}' ) GROUP BY att_ck_technique ORDER BY eventos DESC",
          "datasource": { "type": "postgres", "uid": "postgres-honeypots" }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "none" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "pieType": "pie",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Detalle de eventos por técnica",
      "datasource": { "type": "postgres", "uid": "postgres-honeypots" },
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT timestamp, att_ck_technique, src_ip, source_honeypot, risk_score FROM honeypot_events WHERE $__timeFilter(timestamp) AND ( '$technique' = '' OR att_ck_technique = '${technique:singlequote}' ) ORDER BY timestamp DESC",
          "datasource": { "type": "postgres", "uid": "postgres-honeypots" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "timestamp" },
            "properties": [
              { "id": "unit", "value": "datetime" },
              { "id": "custom.width", "value": 170 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "risk_score" },
            "properties": [ { "id": "custom.width", "value": 90 } ]
          },
          {
            "matcher": { "id": "byName", "options": "source_honeypot" },
            "properties": [ { "id": "custom.width", "value": 120 } ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "enablePagination": true, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [ { "displayName": "timestamp", "desc": true } ]
      }
    }
  ]
}
