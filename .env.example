POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
N8N_BASIC_AUTH_ACTIVE=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
# n8n Public API key (UI n8n: Settings > n8n API > Create API key) — usada por soc-api para /api/v1/* de n8n
N8N_API_KEY=
WEBHOOK_URL=
COWRIE_SSH_PORT=
COWRIE_TELNET_PORT=
DIONAEA_SMB_PORT=
DIONAEA_FTP_PORT=
DIONAEA_HTTP_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=
NETWORK_DMZ_SUBNET=
NETWORK_INTERNAL_SUBNET=

# --- Consola web SOC ---
# Credenciales del usuario admin de la consola (login) y secreto usado por soc-api para firmar los tokens JWT
SOC_ADMIN_USER=
SOC_ADMIN_PASSWORD=
SOC_JWT_SECRET=
# NOTA: N8N_API_KEY y POSTGRES_* ya existían en este archivo; soc-api los reutiliza tal cual (sin cambios).

# --- GLPI (servicio glpi + glpi-db, MySQL dedicado en red_interna) ---
# GLPI solo soporta MySQL/MariaDB; NO usa la PostgreSQL del stack.
GLPI_DB_HOST=glpi-db
GLPI_DB_PORT=3306
GLPI_DB_NAME=
GLPI_DB_USER=
GLPI_DB_PASSWORD=
# Contraseña root del MySQL dedicado (solo admin interno de glpi-db, no la consume GLPI)
GLPI_DB_ROOT_PASSWORD=
# Puerto host de la UI de GLPI (bind a 127.0.0.1). Default 8080, pero CHOCA con DIONAEA_HTTP_PORT → usar 8081.
GLPI_PORT=8081
# Tokens de la REST API de GLPI (se generan en la config manual post-deploy, Grupo 2: Setup > General > API + usuario API dedicado)
GLPI_APP_TOKEN=CHANGEME_tras_configuracion_glpi_grupo2
GLPI_USER_TOKEN=CHANGEME_tras_configuracion_glpi_grupo2