POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
N8N_BASIC_AUTH_ACTIVE=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_ENCRYPTION_KEY=
# n8n Public API key (UI n8n: Settings > n8n API > Create API key) — usada por soc-api para /api/v1/* de n8n
N8N_API_KEY=
WEBHOOK_URL=
COWRIE_SSH_PORT=
COWRIE_TELNET_PORT=
DIONAEA_SMB_PORT=
DIONAEA_FTP_PORT=
DIONAEA_HTTP_PORT=
# Puerto del servicio MSSQL de dionaea (bind ${DIONAEA_MSSQL_PORT}:1433). Si no se
# declara, docker compose emite warning y mapea un puerto aleatorio del host.
DIONAEA_MSSQL_PORT=1433
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=
# Subred de la red DMZ (honeypot_dmz), donde viven cowrie y dionaea.
# La fija docker-compose (red red_dmz -> subnet) y la consume el firewall-agent
# como DMZ_SUBNET en egress-setup.sh para las reglas de egreso de los honeypots.
# Debe MATCHAR la subred real de la red (verificada con: docker network inspect honeypot_dmz).
NETWORK_DMZ_SUBNET=172.20.0.0/24
# Subred de la red interna (red_interna -> honeypot_internal), donde viven
# postgres, n8n, api, web, nginx, glpi, glpi-db y el firewall-agent.
# El firewall-agent escucha en la gateway 172.21.0.1 (AGENT_BIND, fijada en
# docker-compose) y filtra el INPUT del API por esta subred (INTERNAL_SUBNET
# en egress-setup.sh / server.py). Debe MATCHAR la subred real de la red
# (verificada con: docker network inspect honeypot_internal).
NETWORK_INTERNAL_SUBNET=172.21.0.0/24

# --- Consola web SOC ---
# Credenciales del usuario admin de la consola (login) y secreto usado por soc-api para firmar los tokens JWT
SOC_ADMIN_USER=
SOC_ADMIN_PASSWORD=
SOC_JWT_SECRET=
# NOTA: N8N_API_KEY y POSTGRES_* ya existían en este archivo; soc-api los reutiliza tal cual (sin cambios).

# --- GLPI (servicio glpi + glpi-db, MySQL dedicado en red_interna) ---
# GLPI solo soporta MySQL/MariaDB; NO usa la PostgreSQL del stack.
GLPI_DB_HOST=glpi-db
GLPI_DB_PORT=3306
GLPI_DB_NAME=
GLPI_DB_USER=
GLPI_DB_PASSWORD=
# Contraseña root del MySQL dedicado (solo admin interno de glpi-db, no la consume GLPI)
GLPI_DB_ROOT_PASSWORD=
# Puerto host de la UI de GLPI (bind a 127.0.0.1). Default 8080, pero CHOCA con DIONAEA_HTTP_PORT → usar 8081.
GLPI_PORT=8081
# Tokens de la REST API de GLPI (se generan en la config manual post-deploy, Grupo 2: Setup > General > API + usuario API dedicado)
GLPI_APP_TOKEN=CHANGEME_tras_configuracion_glpi_grupo2
GLPI_USER_TOKEN=CHANGEME_tras_configuracion_glpi_grupo2

# --- firewall-agent (API interna de bloqueo) ---
# Secreto compartido exigido en el header X-Agent-Secret por TODOS los endpoints del agente.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# El agente NO arranca si esta vacio (fail-closed). Los tokens de GLPI ya NO se pasan al agente:
# viven en el credential store de n8n.
AGENT_SECRET=CHANGEME_generar_con_secrets_token_urlsafe_32